{
  "name": "kraken-algo-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Non-custodial automated on-chain trading for BTC, ETH and SOL.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @kab/web",
    "dev:api": "npm run dev -w @kab/api",
    "dev:worker": "npm run dev -w @kab/worker",
    "build": "npm run build --workspaces --if-present",
    "test": "node --experimental-strip-types --import ./.grok/ts-register.mjs --test apps/api/src/**/*.test.ts apps/worker/src/**/*.test.ts packages/engine/src/**/*.test.ts packages/execution/src/**/*.test.ts",
    "test:engine": "npm run test -w @kab/engine",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
