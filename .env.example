# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
PORT=8080
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# --- Database / cache ---
DATABASE_URL=postgres://kab:kab@localhost:5432/kab
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Used only to sign session cookies. Never used to sign chain transactions.
SESSION_SECRET=replace-with-64-char-hex
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000

# --- Chains / RPC (read + broadcast only) ---
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
ETH_CHAIN_ID=1
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Testnet overrides
ETH_TESTNET_RPC_URL=https://sepolia.drpc.org
ETH_TESTNET_CHAIN_ID=11155111
SOLANA_TESTNET_RPC_URL=https://api.devnet.solana.com
ACTIVE_NETWORK=testnet

# --- Contracts (allowlisted) ---
EXECUTION_ROUTER_ETH=
ADAPTER_UNISWAP_V3=
ADAPTER_REGISTRY=

# --- Execution policy ---
DEFAULT_MAX_SLIPPAGE_BPS=50
DEFAULT_DEADLINE_SECONDS=180
MAX_RISK_PCT=2
KEEPER_ADDRESS=

# --- Market data ---
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
PRICE_POLL_MS=15000

# --- Optional Kraken connector (operator venue, not user custody) ---
KRAKEN_ENABLED=false
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_BASE_URL=https://api.kraken.com

# --- Observability ---
SENTRY_DSN=
ALERT_WEBHOOK_URL=

# --- Admin RBAC ---
ADMIN_WALLETS=
